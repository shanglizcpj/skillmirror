# A服务地址
# 本地开发使用127.0.0.1:8000
SKILLMIRROR_A_BASE_URL=http://127.0.0.1:8000

# A与B共享的内部调用Token
# 必须至少32字节，正式使用时替换
SKILLMIRROR_INTERNAL_TOKEN=replace-with-the-shared-internal-token-at-least-32-bytes

# A与B共享的B侧记录签名Secret
# 必须至少32字节，正式使用时替换
SKILLMIRROR_B_PROVENANCE_SECRET=replace-with-the-shared-b-provenance-secret-at-least-32-bytes

# 故障测试接口，正常运行必须保持0
SKILLMIRROR_ENABLE_FAILURE_TESTS=0