{
  "project": "SkillMirror",
  "version": "2.1.0",
  "calibration_status": "MVP expert-designed parameters; not yet calibrated on real learners",
  "principles": [
    "Only verified task records can become score-bearing evidence.",
    "Rule-owned skill, strength, direction, performance score and reliability cannot be overridden by an LLM candidate.",
    "A first failed modification is neutral; repeated no-progress attempts may become negative process evidence.",
    "Hint use measures independence and never by itself proves low ability.",
    "Every evidence item has stable identity, verification references and a source digest."
  ],
  "rules": [
    {
      "rule_id": "EVR-OUTCOME-001",
      "event": "challenge_tests_passed",
      "skill": "$target_skill",
      "sub_skill": "$target_subskill",
      "direction": "positive",
      "evidence_strength": "strong",
      "performance_score": 92,
      "score_delta": 10,
      "reliability": 0.98,
      "required_verification_types": ["hidden_test_result"],
      "description": "All verified hidden tests passed."
    },
    {
      "rule_id": "EVR-DEBUG-001",
      "event": "ran_program_proactively",
      "skill": "debugging",
      "sub_skill": "fix_strategy",
      "direction": "positive",
      "evidence_strength": "medium",
      "performance_score": 68,
      "score_delta": 3,
      "reliability": 0.82,
      "required_verification_types": ["run_log"],
      "description": "Learner ran the program during diagnosis."
    },
    {
      "rule_id": "EVR-DEBUG-002",
      "event": "designed_boundary_input_proactively",
      "skill": "debugging",
      "sub_skill": "boundary_awareness",
      "direction": "positive",
      "evidence_strength": "strong",
      "performance_score": 88,
      "score_delta": 7,
      "reliability": 0.92,
      "required_verification_types": ["custom_test_log"],
      "description": "Learner added or executed a boundary input before final submission."
    },
    {
      "rule_id": "EVR-DEBUG-003",
      "event": "reproduced_bug_before_modification",
      "skill": "debugging",
      "sub_skill": "root_cause_analysis",
      "direction": "positive",
      "evidence_strength": "strong",
      "performance_score": 86,
      "score_delta": 6,
      "reliability": 0.90,
      "required_verification_types": ["error_reproduction_log"],
      "description": "Learner reproduced the failure before editing."
    },
    {
      "rule_id": "EVR-DEBUG-004",
      "event": "first_fix_failed",
      "skill": "debugging",
      "sub_skill": "fix_strategy",
      "direction": "neutral",
      "evidence_strength": "weak",
      "performance_score": 50,
      "score_delta": 0,
      "reliability": 0.75,
      "required_verification_types": ["test_history"],
      "description": "The first failed fix is retained as process context and does not directly reduce ability."
    },
    {
      "rule_id": "EVR-DEBUG-005",
      "event": "repeated_ineffective_modifications",
      "skill": "debugging",
      "sub_skill": "fix_strategy",
      "direction": "negative",
      "evidence_strength": "medium",
      "performance_score": 30,
      "score_delta": -5,
      "reliability": 0.88,
      "required_verification_types": ["test_history"],
      "description": "At least two consecutive code changes produced no verified test progress."
    },
    {
      "rule_id": "EVR-DEBUG-006",
      "event": "introduced_new_bug_after_fix",
      "skill": "debugging",
      "sub_skill": "fix_verification",
      "direction": "negative",
      "evidence_strength": "strong",
      "performance_score": 25,
      "score_delta": -6,
      "reliability": 0.94,
      "required_verification_types": ["regression_test_result"],
      "description": "A previously passing verified case regressed after a modification."
    },
    {
      "rule_id": "EVR-HINT-001",
      "event": "used_hint_level_1",
      "skill": "problem_solving",
      "sub_skill": "strategy_selection",
      "direction": "dependency",
      "evidence_strength": "medium",
      "performance_score": null,
      "score_delta": 0,
      "reliability": 0.98,
      "hint_level": "level_1",
      "required_verification_types": ["hint_record"],
      "description": "A Level-1 directional hint was used."
    },
    {
      "rule_id": "EVR-HINT-002",
      "event": "used_hint_level_2",
      "skill": "problem_solving",
      "sub_skill": "strategy_selection",
      "direction": "dependency",
      "evidence_strength": "medium",
      "performance_score": null,
      "score_delta": 0,
      "reliability": 0.98,
      "hint_level": "level_2",
      "required_verification_types": ["hint_record"],
      "description": "A Level-2 localized hint was used."
    },
    {
      "rule_id": "EVR-HINT-003",
      "event": "used_hint_level_3",
      "skill": "problem_solving",
      "sub_skill": "strategy_selection",
      "direction": "dependency",
      "evidence_strength": "strong",
      "performance_score": null,
      "score_delta": 0,
      "reliability": 0.98,
      "hint_level": "level_3",
      "required_verification_types": ["hint_record"],
      "description": "A Level-3 conceptual explanation was used."
    }
  ]
}
