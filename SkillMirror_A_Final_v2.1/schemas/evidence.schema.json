{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillMirror Traceable Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_id", "rule_id", "rule_version", "user_id",
    "session_id", "challenge_id", "challenge_digest", "challenge_type", "skill", "sub_skill",
    "event", "strength", "direction", "performance_score", "score_delta",
    "difficulty", "hint_level", "reliability", "verification_refs",
    "source_digest", "reason", "timestamp", "provenance"
  ],
  "properties": {
    "schema_version": {"const": "2.1"},
    "evidence_id": {"type": "string", "pattern": "^EV-[0-9a-f]{16}$"},
    "rule_id": {"type": "string", "minLength": 1},
    "rule_version": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "challenge_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "challenge_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "challenge_type": {"type": "string", "minLength": 1, "maxLength": 80},
    "skill": {"enum": ["coding", "debugging", "testing", "problem_solving", "code_reading"]},
    "sub_skill": {"type": "string", "minLength": 1, "maxLength": 80},
    "event": {"type": "string", "minLength": 1, "maxLength": 120},
    "strength": {"enum": ["weak", "medium", "strong"]},
    "direction": {"enum": ["positive", "negative", "neutral", "dependency", "informational"]},
    "performance_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "score_delta": {"type": "number", "minimum": -100, "maximum": 100},
    "difficulty": {"enum": ["easy", "medium", "hard", "expert"]},
    "hint_level": {"enum": ["none", "level_1", "level_2", "level_3", "direct_help"]},
    "reliability": {"type": "number", "minimum": 0, "maximum": 1},
    "verification_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 600},
    "timestamp": {"type": "string", "format": "date-time"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "algorithm", "issuer", "purpose", "signature"],
      "properties": {
        "version": {"const": "trust-envelope/1.0"},
        "algorithm": {"const": "HMAC-SHA256"},
        "issuer": {"const": "skillmirror-a-evidence-engine"},
        "purpose": {"const": "trusted-evidence"},
        "signature": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
